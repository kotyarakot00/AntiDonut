{
  "schemaVersion": 1,
  "id": "antidonut",
  "version": "${version}",
  "name": "AntiDonut",
  "description": "DonutSMP cheats for Meteor Client",
  "authors": [
    "kotyarakot"
  ],
  "contact": {
    "sources": "https://github.com"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.AntiDonut"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
